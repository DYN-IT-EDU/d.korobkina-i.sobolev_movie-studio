{
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "/movies(.*)",
      "target": "/movies/$1",
      "destination": "movie-studio-backend",
      "authenticationType": "xsuaa"
    },
    {
      "source": "/contracts(.*)",
      "target": "/contracts/$1",
      "destination": "movie-studio-backend",
      "authenticationType": "xsuaa"
    },
    {
      "source": "/equipment(.*)",
      "target": "/equipment/$1",
      "destination": "movie-studio-backend",
      "authenticationType": "xsuaa"
    },
    {
      "source": "/scenes(.*)",
      "target": "/scenes/$1",
      "destination": "movie-studio-backend",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/keyuser/(.*)$",
      "target": "$1",
      "service": "com.sap.ui.flex.cf.keyuser",
      "endpoint": "keyuser"
    },
    {
      "source": "/user-api/currentUser$",
      "target": "/currentUser",
      "service": "sap-approuter-userapi",
      "authenticationType": "xsuaa"
    }
  ],
  "welcomeFile": "/nsscenesweb"
}
