{
  "xsappname": "movie-studio",
  "tenant-mode": "dedicated",
  "description": "Security profile of called application",
  "scopes": [
    {
      "name": "uaa.user",
      "description": "UAA"
    },
    {
      "name": "$XSAPPNAME.ContractsViewer",
      "description": "ContractsViewer"
    },
    {
      "name": "$XSAPPNAME.ContractsManager",
      "description": "ContractsManager"
    },
    {
      "name": "$XSAPPNAME.WarehouseStaff",
      "description": "WarehouseStaff"
    },
    {
      "name": "$XSAPPNAME.StaffMember",
      "description": "StaffMember"
    },
    {
      "name": "$XSAPPNAME.ScenesManager",
      "description": "ScenesManager"
    }
  ],
  "role-templates": [
    {
      "name": "Token_Exchange",
      "description": "UAA",
      "scope-references": [
        "uaa.user"
      ]
    }
  ],
  "oauth2-configuration": {
    "credential-types": [
      "binding-secret",
      "x509"
    ],
    "redirect-uris": [
      "https://*.hana.ondemand.com/**"
    ]
  },
  "attributes": []
}
