{
  "_version": "1.65.0",
  "sap.app": {
    "id": "ns.movies",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "subTitle": "{{appSubTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.16.2",
      "toolsId": "f08b5c98-2770-472c-bcb8-d24d19675ddd"
    },
    "dataSources": {
      "mainService": {
        "uri": "/movies/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "movies-display": {
          "semanticObject": "movies",
          "action": "display",
          "title": "Movies",
           "subTitle": "Manage Movies",
                    "icon": "sap-icon://flight",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.132.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ns.movies.i18n.i18n",
          "supportedLocales": ["ru", "en"],
          "fallbackLocale": "en"
        } 

      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MoviesList",
          "target": "MoviesList"
        },
        {
          "pattern": "Movies({key}):?query:",
          "name": "MoviesObjectPage",
          "target": "MoviesObjectPage"
        },
        {
          "pattern": "Movies({key})/scenes({key2}):?query:",
          "name": "ScenesObjectPage",
          "target": "ScenesObjectPage"
        }
      ],
      "targets": {
        "MoviesList": {
          "type": "Component",
          "id": "MoviesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Movies",
              "enhanceI18n": "i18n/custom.properties",
              "initialLoad": "Enabled",
              "variantManagement": "None",
              "navigation": {
                "Movies": {
                  "detail": {
                    "route": "MoviesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                  "useSemanticDateRange": true,
                  "filterFields": {
                      "releaseDate": {
                        "settings": {
                          "defaultValues": [{"operator": "LASTYEARS", "values": [100]}],
                          "operatorConfiguration": [
                              {
                                  "path": "key",
                                   "equals": "TODAY",
                                   "exclude": false
                               },
                               {
                                 "path": "key",
                                  "equals": "TODAYXYDAYS",
                                  "exclude": true
                               }
                         ]
                      }
                      }
                  }
                  
              }
               
              }
            }
          }
        },
        "MoviesObjectPage": {
          "type": "Component",
          "id": "MoviesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Movies",
              "navigation": {
                "scenes": {
                  "detail": {
                    "route": "ScenesObjectPage"
                  }
                }
              }
            }
          }
        },
        "ScenesObjectPage": {
          "type": "Component",
          "id": "ScenesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent":false,
              "contextPath": "/Movies/scenes"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
      "public": true,
       "service": "movies.service"
    } 
}
