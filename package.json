{
  "name": "movie-studio",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1.5.2",
    "@sap/cds": "^8",
    "@sap/xssec": "^4.2.7",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.7.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "try": "cf deploy .\\mta_archives\\movie-studio_1.0.0.mtar",
    "watch-scenes-web": "cds watch --open scenes-web/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy movie-studio --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-replacemodulename": "cds watch --open replacemodulename/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "sql": {
      "native_hana_associations": false
    },
    "requires": {
      "[hybrid]": {
        "db": "hana"
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      }
    }
  },
  "sapux": [
    "app/scenes-web",
    "app/replacemodulename"
  ]
}
